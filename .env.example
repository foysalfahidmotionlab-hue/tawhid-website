# Copy the values you need into your host's environment settings.
# No secrets are required — admin accounts are created with `npm run admin:create`.

# Port the production server listens on
PORT=8787

# Must be "production" on the live server (enables secure cookies)
NODE_ENV=production

# Folder for the SQLite database and uploaded images (must be on a persistent disk)
DATA_DIR=./data

# Set to 1 when running behind a reverse proxy (Nginx, Caddy, Render, Railway)
TRUST_PROXY=1
